{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    { "name": "gcc",   "hidden": true, "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" } },
    { "name": "clang", "hidden": true, "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" } },
    {
      "name": "msvc",
      "hidden": true,
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    { "name": "mode-debug",   "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "mode-release", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },

    { "name": "debug",   "displayName": "Default Debug (system compiler)",   "inherits": ["base", "mode-debug"] },
    { "name": "release", "displayName": "Default Release (system compiler)", "inherits": ["base", "mode-release"] },
    { "name": "gcc-debug",     "displayName": "GCC Debug",     "inherits": ["base", "gcc",   "mode-debug"] },
    { "name": "gcc-release",   "displayName": "GCC Release",   "inherits": ["base", "gcc",   "mode-release"] },
    { "name": "clang-debug",   "displayName": "Clang Debug",   "inherits": ["base", "clang", "mode-debug"] },
    { "name": "clang-release", "displayName": "Clang Release", "inherits": ["base", "clang", "mode-release"] },
    { "name": "msvc-debug",    "displayName": "MSVC Debug",    "inherits": ["base", "msvc",  "mode-debug"] },
    { "name": "msvc-release",  "displayName": "MSVC Release",  "inherits": ["base", "msvc",  "mode-release"] }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "gcc-debug",     "configurePreset": "gcc-debug" },
    { "name": "gcc-release",   "configurePreset": "gcc-release" },
    { "name": "clang-debug",   "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "msvc-debug",    "configurePreset": "msvc-debug" },
    { "name": "msvc-release",  "configurePreset": "msvc-release" }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "debug",   "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "gcc-debug",     "configurePreset": "gcc-debug",     "output": { "outputOnFailure": true } },
    { "name": "gcc-release",   "configurePreset": "gcc-release",   "output": { "outputOnFailure": true } },
    { "name": "clang-debug",   "configurePreset": "clang-debug",   "output": { "outputOnFailure": true } },
    { "name": "clang-release", "configurePreset": "clang-release", "output": { "outputOnFailure": true } },
    { "name": "msvc-debug",    "configurePreset": "msvc-debug",    "output": { "outputOnFailure": true } },
    { "name": "msvc-release",  "configurePreset": "msvc-release",  "output": { "outputOnFailure": true } }
  ]
}
